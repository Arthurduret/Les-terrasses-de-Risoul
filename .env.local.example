# Copier ce fichier en `.env.local` et renseigner les valeurs depuis
# le dashboard Supabase (Project Settings > API).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Serveur uniquement — ne jamais exposer côté client.
SUPABASE_SERVICE_ROLE_KEY=

# Clé API Resend ("Sending access" uniquement) — dashboard Resend > API Keys.
RESEND_API_KEY=
# Adresse d'expédition — nécessite un domaine vérifié dans Resend (Domains).
# Sans domaine vérifié, laisser vide : lib/email.ts retombe sur
# onboarding@resend.dev (n'envoie qu'à l'adresse du compte Resend).
RESEND_FROM_EMAIL="Les Terrasses de Risoul <reservations@lesterrassesderisoul.fr>"
